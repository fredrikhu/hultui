<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TextMate-backed syntax tokenizing for HultUI text elements. Kept out of
    HultUI.Core, whose zero-external-dependency guarantee this would break: it
    pulls TextMateSharp and its bundled grammar set. Apps that want coloured
    code reference this; apps that don't pay nothing.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HultUI.Syntax</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>HultUI syntax highlighting: TextMate-grammar tokenization producing TextSpan lists for code display.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HultUI.Core\HultUI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The table tests compare CanHighlight with the registry, and count registry use; so does
         Meridian's, to show that a response is tokenized on a worker, never on the UI thread. -->
    <InternalsVisibleTo Include="HultUI.Syntax.Tests" />
    <InternalsVisibleTo Include="HultUI.Icons.Tests" />
    <InternalsVisibleTo Include="Meridian.Tests" />
  </ItemGroup>

</Project>
