<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(HultUITargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HultUI.Platform.SDL3</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>HultUI SDL3 platform: windowing, input, clipboard, file dialogs, GL surface.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HultUI.Platform.SDL3.Tests" />
    <!-- WindowStateActivationTests reads WindowsActivation.Refused. -->
    <InternalsVisibleTo Include="HultUI.UiTests" />
    <!-- The Android activity hands SDL3Window the insets content should clear (SetContentInsets):
         Android's bars and cutout, without the gesture zones SDL's own safe area takes out. -->
    <InternalsVisibleTo Include="HultUI.Platform.Android" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HultUI.Core\HultUI.Core.csproj" />
    <ProjectReference Include="..\HultUI.Rendering.Skia\HultUI.Rendering.Skia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
    <!-- Phase 1 of docs/design/HDR.md. Structs and enums only: the commands are loaded
         through vkGetDeviceProcAddr in VulkanCommands.cs, because this package generates
         the types but exposes only the global bootstrap calls as methods. -->
    <PackageReference Include="Vortice.Vulkan" Version="3.3.0" />
  </ItemGroup>

</Project>
