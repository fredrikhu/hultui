<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(HultUITargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HultUI.Rendering.Skia</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- NativeTextBlob: four functions of SkiaSharp's C API, called through function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>HultUI SkiaSharp renderer: GPU and raster backends, HarfBuzz shaping, font fallback, emoji.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HultUI.Core\HultUI.Core.csproj" />
    <ProjectReference Include="..\HultUI.Text\HultUI.Text.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- HdrVideoLuminance: the HDR video arithmetic, tested without a GPU. -->
    <InternalsVisibleTo Include="HultUI.Rendering.Skia.Tests" />
    <!-- SDL3Window: the Vulkan surface's purges once a size change has rested and at rest, run from its pump. -->
    <InternalsVisibleTo Include="HultUI.Platform.SDL3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.156.1" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="4.156.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.156.1" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.4.0.101" />
  </ItemGroup>

</Project>
