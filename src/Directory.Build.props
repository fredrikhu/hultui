<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <!-- Every framework project packs, with shared metadata. Versioning: one version
       for the whole family (VersionPrefix in the root props); project-to-project
       references become exact-version package dependencies automatically.
       License: MPL-2.0 (the repository's LICENSE). Packages built from third-party
       code set their own: Media.Mpv.Natives, WebView.Cef.Natives, Terminal.XTermNet. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/fredrikhu/hultui</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ui;gui;framework;flexbox;reactive;skia;sdl3;cross-platform</PackageTags>
    <!-- The XML docs the API reference will harvest; missing-comment noise is not
         a build error the framework wants (docs are added where they earn keep). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
