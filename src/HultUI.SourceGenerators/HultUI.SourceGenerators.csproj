<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>HultUI.SourceGenerators</RootNamespace>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <Description>Roslyn source generators and analyzers for HultUI: [Reactive] property generation and the style-mutation diagnostics. Included inside the HultUI package; reference directly only for Core-only projects.</Description>
    <!-- Generator packaging shape: the dll ships under analyzers/, not lib/, and
         consumers get no runtime dependency on it. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- No lib/ output means nothing to put in a symbols package; an empty snupkg
         is a pack error (NU5017). -->
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.*" />
  </ItemGroup>

  <!-- AnalyzerReleases.Shipped.md / .Unshipped.md are picked up automatically by
       the analyzer SDK; including them explicitly as well makes every consumer of
       this project file (DocFX among them) see each one twice. -->

</Project>
