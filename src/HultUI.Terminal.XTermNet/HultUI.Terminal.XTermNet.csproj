<Project Sdk="Microsoft.NET.Sdk">

  <!-- XTerm.NET (MIT, Tom Laird-McConnell), built from external/XTerm.NET: upstream at the commit
       in external/XTerm.NET.version with HultUI's patches applied (docs/design/TERMINAL.md, "The
       patched engine"). The sources are generated by scripts/vendor-xterm-net.ps1 and never
       edited here; this project only says how to build them.

       Its own assembly name, so an app that also references the stock XTerm.NET package does
       not get two XTerm.NET.dll files. The namespaces stay XTerm.*: renaming them would make
       every patch and every upstream update conflict. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>XTerm</RootNamespace>
    <AssemblyName>HultUI.Terminal.XTermNet</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- src/Directory.Build.props turns the XML documentation file on for every framework
         project. Upstream never builds one, and its comments are not well-formed XML (51
         CS15xx/CS1658 warnings). HultUI.Terminal's API exposes no XTerm type, so nothing is lost;
         and the vendored files may not be edited to fix them. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Upstream's licence, not the repository's MPL-2.0: every file here is XTerm.NET's. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>XTerm.NET, the terminal emulator engine behind HultUI.Terminal, built from upstream source with HultUI's patches: cursor-line reflow, capacity-keeping resize, overline, Alt/Ctrl key encodings, the row shrink, and kitty graphics fixes. MIT, Tom Laird-McConnell.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\external\XTerm.NET\src\XTerm.NET\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Upstream's Assembly.cs grants XTerm.NET.Tests; the vendored suite builds under this name. -->
    <InternalsVisibleTo Include="HultUI.Terminal.XTermNet.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- MIT asks for the notice to travel with the code. -->
    <None Include="..\..\external\XTerm.NET\LICENSE" Pack="true" PackagePath="licenses\XTerm.NET\" Visible="false" />
  </ItemGroup>

</Project>
