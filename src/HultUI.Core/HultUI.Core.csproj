<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HultUI.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>HultUI core: element tree, flexbox and grid layout, fine-grained reactivity (Signal/Computed/Effect), events, styling, dialogs, virtualization. Zero external dependencies.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HultUI.Core.Tests" />
    <InternalsVisibleTo Include="HultUI" />
    <InternalsVisibleTo Include="HultUI.Headless" />
    <InternalsVisibleTo Include="HultUI.Headless.Tests" />
    <!-- VideoElement overrides MeasureContent and PatchFrom, which are internal;
         a first-party element package gets the same access the framework has. -->
    <InternalsVisibleTo Include="HultUI.Media" />
    <!-- WebViewElement registers element-owned handlers (OnOwn), keeps its controller
         across rebuilds (PatchFrom) and asks for text input when its engine takes
         forwarded keys (WantsTextInput). -->
    <InternalsVisibleTo Include="HultUI.WebView" />
    <!-- TerminalElement registers element-owned handlers (OnOwn), keeps its controller across
         rebuilds (PatchFrom) and arms text input and the IME while focused (WantsTextInput). -->
    <InternalsVisibleTo Include="HultUI.Terminal" />
    <!-- RendererSelection: the renderer choice lives here so Core.Tests can cover it, and
         the SDL3 platform is what acts on it. -->
    <InternalsVisibleTo Include="HultUI.Platform.SDL3" />
  </ItemGroup>

</Project>
