<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(HultUITargetFramework)-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HultUI.WinForms</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>HultUI for WinForms: mount a HultUI element tree as a System.Windows.Forms control, for applications migrating from WinForms a page at a time. Renders with OpenGL on the control's own window handle — no SDL — so focus, tab order and input stay WinForms' business.</Description>
  </PropertyGroup>

  <!-- The only Windows-Desktop-flavoured project in the repo. It is deliberately not
       in HultUI.CrossPlatform.slnf or docfx.json: both run on Linux, where
       a -windows target framework will not build. -->
  <ItemGroup>
    <!-- The key map is a lookup table nothing else can reach; it is tested directly. -->
    <InternalsVisibleTo Include="HultUI.UiTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HultUI\HultUI.csproj" />
  </ItemGroup>

</Project>
