<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HultUI.Platform.Accessibility.Linux</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <SupportedOSPlatform>linux</SupportedOSPlatform>
    <Description>HultUI Linux accessibility: AT-SPI2 D-Bus bridge.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HultUI.Core\HultUI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HultUI.Platform.Accessibility.Linux.Tests" />
    <!-- Drives the bridge from a headless window, with its signals recorded (IAtSpiSignals). -->
    <InternalsVisibleTo Include="HultUI.Headless.Tests" />
    <!-- The perf suite's AT-SPI rows: the bridge in process, its signals counted (IAtSpiSignals). -->
    <InternalsVisibleTo Include="HultUI.Samples.PerfSuite" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.92.0" />
  </ItemGroup>

</Project>
