<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Icon artwork shared by the HultUI apps: file-type glyphs (FileIcons) and the
    Phosphor set the Junction design calls for (Phosphor). Both rasterize SVG path
    data through the same cache.

    Which glyph a *file* gets is decided by HultUI.Syntax: if the highlighter can
    colour it, it is code. That is the point of sharing it — a per-app list of
    "code" extensions drifts from the grammar set, and two apps' lists drift from
    each other.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HultUI.Icons</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>HultUI icon library: cached, palette-tinted vector glyph rasterization (Phosphor set and file-type icons).</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VesperCommander.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HultUI.Core\HultUI.Core.csproj" />
    <ProjectReference Include="..\HultUI.Rendering.Skia\HultUI.Rendering.Skia.csproj" />
    <ProjectReference Include="..\HultUI.Syntax\HultUI.Syntax.csproj" />
  </ItemGroup>

</Project>
