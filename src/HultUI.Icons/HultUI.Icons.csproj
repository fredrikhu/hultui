<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Phosphor set the Junction design calls for, rasterized from SVG path data.

    No HultUI.Syntax here: an app that wants only these icons should not ship a
    TextMate grammar engine and a native regex library. PhosphorTests'
    PhosphorAloneBringsNoSyntaxHighlighter keeps it that way. The file-type glyphs,
    which ask the highlighter what is code, are HultUI.Icons.Files.
  -->
  <PropertyGroup>
    <TargetFramework>$(HultUITargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HultUI.Icons</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>HultUI icon library: cached, palette-tinted vector glyph rasterization (the Phosphor set).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HultUI.Core\HultUI.Core.csproj" />
    <ProjectReference Include="..\HultUI.Rendering.Skia\HultUI.Rendering.Skia.csproj" />
  </ItemGroup>

  <!-- Phosphor.Paths.g.cs is upstream artwork, MIT-licensed by Phosphor Icons; MIT asks
       for the notice to travel with it. Copied verbatim from @phosphor-icons/core 2.1.1. -->
  <ItemGroup>
    <None Include="LICENSE-Phosphor.txt" Pack="true" PackagePath="licenses\" />
  </ItemGroup>

</Project>
