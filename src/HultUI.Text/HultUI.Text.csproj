<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HultUI.Text</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>HultUI text pipeline: shaping-agnostic layout, UAX #14 line breaking and UAX #9 BiDi via platform ICU, word-level shape caching.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HultUI.Core\HultUI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TextPipeline.ShortcutTruncation: the reference path the truncation tests compare against. -->
    <InternalsVisibleTo Include="HultUI.Text.Tests" />
    <InternalsVisibleTo Include="HultUI.Rendering.Skia.Tests" />
  </ItemGroup>

</Project>
