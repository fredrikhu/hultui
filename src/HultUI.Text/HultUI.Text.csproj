<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HultUI.Text</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>HultUI text pipeline: shaping-agnostic layout, UAX #14 line breaking and UAX #9 BiDi via platform ICU, word-level shape caching.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HultUI.Core\HultUI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TextPipeline.ReuseAcrossWidths: the reference path WidthChangeEquivalenceTests compare against; LineBreaker. -->
    <InternalsVisibleTo Include="HultUI.Text.Tests" />
    <InternalsVisibleTo Include="HultUI.Rendering.Skia.Tests" />
    <!-- The run-blob maps match runs whose glyphs follow from their text by the text
         (ShapedRun.GlyphsFollowText), count glyphs without putting them together (GlyphCount),
         and build a new blob from a run's words without a glyph array (ComposeGlyphsInto). -->
    <InternalsVisibleTo Include="HultUI.Rendering.Skia" />
  </ItemGroup>

</Project>
