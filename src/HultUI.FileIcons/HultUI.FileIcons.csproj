<Project Sdk="Microsoft.NET.Sdk">

  <!--
    File-type icons shared by the HultUI apps. Which glyph a file gets is decided
    by HultUI.Syntax: if the highlighter can colour it, it is code. That is the
    whole point of the shared library — a per-app list of "code" extensions
    drifts from the grammar set, and two apps' lists drift from each other.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HultUI.FileIcons</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HultUI.Core\HultUI.Core.csproj" />
    <ProjectReference Include="..\HultUI.Rendering.Skia\HultUI.Rendering.Skia.csproj" />
    <ProjectReference Include="..\HultUI.Syntax\HultUI.Syntax.csproj" />
  </ItemGroup>

</Project>
