<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HultUI.Platform.Accessibility.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Source is portable; runtime APIs only execute on Windows via
         OperatingSystem.IsWindows() / SupportedOSPlatform checks. -->
    <SupportedOSPlatform>windows</SupportedOSPlatform>
    <Description>HultUI Windows accessibility: UI Automation provider bridge, NativeAOT-compatible.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HultUI.Core\HultUI.Core.csproj" />
    <ProjectReference Include="..\HultUI.Platform.SDL3\HultUI.Platform.SDL3.csproj" />
  </ItemGroup>

</Project>
