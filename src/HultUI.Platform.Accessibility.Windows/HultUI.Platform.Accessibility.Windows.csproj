<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(HultUITargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HultUI.Platform.Accessibility.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Source is portable; runtime APIs only execute on Windows via
         OperatingSystem.IsWindows() / SupportedOSPlatform checks. -->
    <SupportedOSPlatform>windows</SupportedOSPlatform>
    <Description>HultUI Windows accessibility: UI Automation provider bridge, NativeAOT-compatible.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HultUI.Headless.Tests" />
    <!-- HeadlessUiaReader: an app's tests hear what this bridge tells a reader. -->
    <InternalsVisibleTo Include="HultUI.Headless" />
    <!-- The perf suite's UIA rows: the events the bridge raises, counted (WindowsAccessibilityBridge.Raised). -->
    <InternalsVisibleTo Include="HultUI.Samples.PerfSuite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HultUI.Core\HultUI.Core.csproj" />
    <ProjectReference Include="..\HultUI.Platform.SDL3\HultUI.Platform.SDL3.csproj" />
  </ItemGroup>

</Project>
