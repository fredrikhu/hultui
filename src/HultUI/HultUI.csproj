<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HultUI</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <DefineConstants>$(DefineConstants);NATIVE_AOT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HultUI.Core\HultUI.Core.csproj" />
    <ProjectReference Include="..\HultUI.Text\HultUI.Text.csproj" />
    <ProjectReference Include="..\HultUI.Rendering.Skia\HultUI.Rendering.Skia.csproj" />
    <ProjectReference Include="..\HultUI.Platform.SDL3\HultUI.Platform.SDL3.csproj" />
    <ProjectReference Include="..\HultUI.Platform.Accessibility.Windows\HultUI.Platform.Accessibility.Windows.csproj" />
    <ProjectReference Include="..\HultUI.Platform.Accessibility.Linux\HultUI.Platform.Accessibility.Linux.csproj" />
    <ProjectReference Include="..\HultUI.SourceGenerators\HultUI.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
