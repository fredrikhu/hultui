<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HultUI</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>HultUI: a fluent, flexbox-based, reactive UI framework for .NET — SkiaSharp rendering over SDL3, fine-grained SolidJS-style reactivity, NativeAOT-ready. This is the everything-included package; the [Reactive] source generator rides along as an analyzer.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <DefineConstants>$(DefineConstants);NATIVE_AOT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HultUI.Headless" />
    <!-- So the accessibility bridge factory's backend-agnostic selection can be
         tested against a platform window that is not the SDL one. -->
    <InternalsVisibleTo Include="HultUI.Headless.Tests" />
    <!-- The WinForms host pumps the frame loop from a timer in WinForms' message loop: it asks
         for the loop's next deadline and parks it between ticks, as Run does (Application.Host*). -->
    <InternalsVisibleTo Include="HultUI.WinForms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HultUI.Core\HultUI.Core.csproj" />
    <ProjectReference Include="..\HultUI.Text\HultUI.Text.csproj" />
    <ProjectReference Include="..\HultUI.Rendering.Skia\HultUI.Rendering.Skia.csproj" />
    <ProjectReference Include="..\HultUI.Platform.SDL3\HultUI.Platform.SDL3.csproj" />
    <ProjectReference Include="..\HultUI.Platform.Accessibility.Windows\HultUI.Platform.Accessibility.Windows.csproj" />
    <ProjectReference Include="..\HultUI.Platform.Accessibility.Linux\HultUI.Platform.Accessibility.Linux.csproj" />
    <ProjectReference Include="..\HultUI.SourceGenerators\HultUI.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The generator travels INSIDE this package under analyzers/: an analyzer
       project reference produces no package dependency, and "install one package,
       [Reactive] works" is the intended consumption story. Core-only consumers can
       reference the HultUI.SourceGenerators package themselves. -->
  <ItemGroup>
    <None Include="..\HultUI.SourceGenerators\bin\$(Configuration)\netstandard2.0\HultUI.SourceGenerators.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
