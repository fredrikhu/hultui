<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(HultUITargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The app's own root namespace is Aperture, so this project's default would
         nest as Aperture.Tests.Aperture.*. Pin it. -->
    <RootNamespace>Aperture.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\apps\Aperture\Aperture\Aperture.csproj" />
    <ProjectReference Include="..\..\src\HultUI.Headless\HultUI.Headless.csproj" />
    <!-- The TalkBack bridge's platform-neutral part, to read Aperture's views as TalkBack would. -->
    <ProjectReference Include="..\..\src\HultUI.Platform.Accessibility.Android\HultUI.Platform.Accessibility.Android.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The runtime settings the app ships with (apps/AppRuntime.props). -->
    <Compile Include="..\Shared\AppRuntimeSettingsTests.cs" Link="Shared\AppRuntimeSettingsTests.cs" />
  </ItemGroup>

</Project>
