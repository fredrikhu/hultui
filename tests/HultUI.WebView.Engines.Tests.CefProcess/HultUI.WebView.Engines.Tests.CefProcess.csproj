<Project Sdk="Microsoft.NET.Sdk">

  <!-- A process for HultUI.WebView.Engines.Tests' CEF lifetime tests: CEF starts once per
       process and stops when it exits, so the exit is only seen from outside. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HultUI.WebView.Cef\HultUI.WebView.Cef.csproj" />
  </ItemGroup>

</Project>
