<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The app's own root namespace is Junction, so this project's default would
         nest as Junction.Tests.Junction.*. Pin it. -->
    <RootNamespace>Junction.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Recorded GitLab API responses the client tests replay; never the network. -->
    <EmbeddedResource Include="GitLab\Recordings\*.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\apps\Junction\Junction.csproj" />
    <ProjectReference Include="..\..\src\HultUI.Headless\HultUI.Headless.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- No dynamic PGO in this test process: with it, tier-1 code can guess a collection's type
         from the profile and put a boxed enumerator or a closure on the stack, so an allocation
         the code makes (and makes in NativeAOT, at tier 0, before the profile) is not seen
         once the JIT has caught up. The allocation tests measure the code, not the profile. -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- The measure every "allocates nothing" test uses: the least of a few rounds. -->
    <Compile Include="..\Shared\Allocations.cs" Link="Shared\Allocations.cs" />
    <!-- The runtime settings the app ships with (apps/AppRuntime.props). -->
    <Compile Include="..\Shared\AppRuntimeSettingsTests.cs" Link="Shared\AppRuntimeSettingsTests.cs" />
  </ItemGroup>

</Project>
