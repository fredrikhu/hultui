<Project Sdk="Microsoft.NET.Sdk">

  <!-- A window for HultUI.UiTests' Vulkan tests, run as its own process: the renderer is
       chosen once per process, and the Vulkan loader reads its fault-injection variables from
       the environment it starts with. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HultUI\HultUI.csproj" />
    <!-- For the two-page mode: two GPU sources in one Vulkan window. -->
    <ProjectReference Include="..\..\src\HultUI.WebView.WebView2\HultUI.WebView.WebView2.csproj" />
    <ProjectReference Include="..\..\src\HultUI.WebView.Cef\HultUI.WebView.Cef.csproj" />
    <!-- For the page-and-video mode: mpv's shared image beside a page's. -->
    <ProjectReference Include="..\..\src\HultUI.Media\HultUI.Media.csproj" />
    <ProjectReference Include="..\..\src\HultUI.Media.Mpv\HultUI.Media.Mpv.csproj" />
  </ItemGroup>

</Project>
