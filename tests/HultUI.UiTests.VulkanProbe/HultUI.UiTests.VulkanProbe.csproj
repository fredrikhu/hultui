<Project Sdk="Microsoft.NET.Sdk">

  <!-- A window for HultUI.UiTests' Vulkan tests, run as its own process: the renderer is
       chosen once per process, and the Vulkan loader reads its fault-injection variables from
       the environment it starts with. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HultUI\HultUI.csproj" />
  </ItemGroup>

</Project>
