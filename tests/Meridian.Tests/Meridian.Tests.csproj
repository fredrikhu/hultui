<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The app's own root namespace is Meridian, so this project's default would
         nest as Meridian.Tests.Meridian.*. Pin it. -->
    <RootNamespace>Meridian.Tests</RootNamespace>
    <!-- As in every project that links tests/Shared/Allocations.cs: the allocation tests are about
         the code, not what a profile lets tier 1 put on the stack. -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\apps\Meridian\Meridian\Meridian.csproj" />
    <!-- Build the CLI so the end-to-end tests have a binary to run, but do NOT
         copy its output: its assembly is named "meridian", which collides with
         the GUI's "Meridian.dll" on a case-insensitive filesystem and would
         overwrite it. The tests invoke the built binary by path instead.
         Private="false" keeps its runtimeconfig.json, deps.json and apphost out
         too: ReferenceOutputAssembly="false" alone still copies them, and on a
         clean build the CLI's "meridian.runtimeconfig.json" could overwrite the
         GUI's, which AppRuntimeSettingsTests reads (CI, 2026-10-26). -->
    <ProjectReference Include="..\..\apps\Meridian\Meridian.Cli\Meridian.Cli.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\src\HultUI.Headless\HultUI.Headless.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The runtime settings the app ships with (apps/AppRuntime.props). -->
    <Compile Include="..\Shared\AppRuntimeSettingsTests.cs" Link="Shared\AppRuntimeSettingsTests.cs" />
    <Compile Include="..\Shared\Allocations.cs" Link="Shared\Allocations.cs" />
  </ItemGroup>

</Project>
