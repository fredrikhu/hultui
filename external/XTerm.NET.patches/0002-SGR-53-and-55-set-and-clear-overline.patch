From ed57d963a88d3266785a559d826b83213049224c Mon Sep 17 00:00:00 2001
From: Fredrik Hult <fredrik.hult@outlook.com>
Date: Sat, 3 Oct 2026 20:28:17 +0200
Subject: [PATCH 2/4] SGR 53 and 55 set and clear overline

AttributeData has had IsOverline and SetOverline, but the SGR switch had no case for either, so
overline never reached a cell.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/XTerm.NET/InputHandler.Csi.cs | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/XTerm.NET/InputHandler.Csi.cs b/src/XTerm.NET/InputHandler.Csi.cs
index 1e15eb9..e5edaf4 100644
--- a/src/XTerm.NET/InputHandler.Csi.cs
+++ b/src/XTerm.NET/InputHandler.Csi.cs
@@ -1104,6 +1104,12 @@ public partial class InputHandler
                 case 29: // Not strikethrough
                     _curAttr.SetStrikethrough(false);
                     break;
+                case 53: // Overline
+                    _curAttr.SetOverline(true);
+                    break;
+                case 55: // Not overline
+                    _curAttr.SetOverline(false);
+                    break;
                 case >= 30 and <= 37: // Foreground color
                     _curAttr.SetFgColor(param - 30);
                     break;
-- 
