From ed7cb3f690f7f07f73dcb7a5af59e3b6723977fd Mon Sep 17 00:00:00 2001
From: Fredrik Hult <fredrik.hult@outlook.com>
Date: Sat, 3 Oct 2026 20:28:17 +0200
Subject: [PATCH 3/5] Alt prefixes Enter and Backspace, Ctrl+Backspace is BS,
 Ctrl+/ is US

GenerateKeyInput dropped Alt on Enter and Backspace, so Alt+Backspace (readline's and zsh's
backward-kill-word) arrived as a plain DEL. Ctrl+Backspace now sends BS, the other erase
character, as xterm and Windows Terminal do; Ctrl+/ sends 0x1F instead of a literal slash.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/XTerm.NET/Input/KeyboardInputGenerator.cs | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/src/XTerm.NET/Input/KeyboardInputGenerator.cs b/src/XTerm.NET/Input/KeyboardInputGenerator.cs
index 1751f46..dfa0550 100644
--- a/src/XTerm.NET/Input/KeyboardInputGenerator.cs
+++ b/src/XTerm.NET/Input/KeyboardInputGenerator.cs
@@ -30,10 +30,13 @@ public class KeyboardInputGenerator
         // Handle special keys
         return key switch
         {
-            // Control keys
-            Key.Enter => "\r",
+            // Control keys. Alt is the ESC prefix on these as on any character (xterm's
+            // metaSendsEscape): Alt+Backspace is readline's and zsh's backward-kill-word, and it
+            // was arriving as a plain DEL. Ctrl+Backspace sends BS, the other erase character,
+            // as xterm and Windows Terminal do, so the two are distinguishable to a program.
+            Key.Enter => AltPrefix("\r", modifiers),
             Key.Tab => (modifiers & KeyModifiers.Shift) != 0 ? "\u001b[Z" : "\t",
-            Key.Backspace => "\u007f", // DEL (127)
+            Key.Backspace => AltPrefix((modifiers & KeyModifiers.Control) != 0 ? "\b" : "\u007f", modifiers),
             // Escape sends ESC whatever the modifiers. CSI 27 ; mod ~ is not a sequence xterm
             // emits -- it belongs to the modifyOtherKeys and Kitty protocols, which an application
             // opts into. Sending it unasked meant a program that reads a bare ESC (vim leaving
@@ -130,6 +133,7 @@ public class KeyboardInputGenerator
                     ']' => "\u001d", // Ctrl+] = GS
                     '^' => "\u001e", // Ctrl+^ = RS
                     '_' => "\u001f", // Ctrl+_ = US
+                    '/' => "\u001f", // Ctrl+/ = US, as xterm and every PC terminal send it (undo in readline and emacs)
                     '?' => "\u007f", // Ctrl+? = DEL
                     _ => c.ToString()
                 };
@@ -150,6 +154,9 @@ public class KeyboardInputGenerator
         return result;
     }
 
+    private static string AltPrefix(string sequence, KeyModifiers modifiers) =>
+        (modifiers & KeyModifiers.Alt) != 0 ? "\u001b" + sequence : sequence;
+
     private string? GetControlCharacter(Key key)
     {
         // Control key combinations
