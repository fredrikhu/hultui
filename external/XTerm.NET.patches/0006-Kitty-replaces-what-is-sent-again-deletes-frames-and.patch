+++ b/src/XTerm.NET/Graphics/ImageAnimation.cs
@@ -100,13 +100,21 @@ public sealed class ImageAnimation
     public int Serial { get; private set; }
 
     /// <summary>Total size of every frame, for accounting against an image budget.</summary>
+    /// <remarks>
+    /// Not the root while it is still the image's own array: <see cref="TerminalImage.ByteCount"/>
+    /// counts that already, and counting it here too made an animated image look a picture larger
+    /// than it is.
+    /// </remarks>
     public long ByteCount
     {
         get
         {
             long total = 0;
             foreach (var frame in _frames)
-                total += frame.Data.LongLength;
+            {
+                if (!ReferenceEquals(frame.Data, Image.PixelArray))
+                    total += frame.Data.LongLength;
+            }
             return total;
         }
     }
@@ -154,6 +162,36 @@ public sealed class ImageAnimation
         return frame.Data;
     }
 
+    /// <summary>
+    /// Deletes a frame, never the last one left, and returns the bytes that released.
+    /// </summary>
+    /// <remarks>
+    /// <para>The frames after it move down a number, the current one with them. Deleting the
+    /// current frame shows the one that took its place, or the new last one. With one frame left
+    /// the animation stops: nothing can move, and a host would otherwise keep a clock running for
+    /// it.</para>
+    /// <para>The root still shared with the image releases nothing: the image holds those pixels
+    /// either way.</para>
+    /// </remarks>
+    internal long RemoveFrame(int number)
+    {
+        if (number < 1 || number > _frames.Count || _frames.Count < 2)
+            return 0;
+
+        var frame = _frames[number - 1];
+        _frames.RemoveAt(number - 1);
+
+        if (number < CurrentFrame || CurrentFrame > _frames.Count)
+            CurrentFrame--;
+
+        if (_frames.Count < 2)
+            State = AnimationState.Stopped;
+
+        _elapsedMilliseconds = 0;
+        Serial++;
+        return ReferenceEquals(frame.Data, Image.PixelArray) ? 0 : frame.Data.LongLength;
+    }
+
     internal void SetGap(int number, int gapMilliseconds)
     {
         if (number >= 1 && number <= _frames.Count)
diff --git a/src/XTerm.NET/Graphics/ImageRegistry.cs b/src/XTerm.NET/Graphics/ImageRegistry.cs
index 71f08ab..d77cd9f 100644
--- a/src/XTerm.NET/Graphics/ImageRegistry.cs
+++ b/src/XTerm.NET/Graphics/ImageRegistry.cs
@@ -24,6 +24,16 @@ internal sealed class ImageRegistry
 
     private long _bytes;
 
+    /// <summary>What each image was charged, so removing it gives back exactly that.</summary>
+    /// <remarks>
+    /// Removal used to subtract the image's size at that moment. An image changes size after it is
+    /// stored (an animation gains and loses frames, and its root is copied when edited), so the
+    /// two disagreed: an animated image counted its root twice and gave back a picture more than it
+    /// was charged, and every one removed left the total that much lower -- below zero in the end,
+    /// where nothing is ever trimmed.
+    /// </remarks>
+    private readonly Dictionary<uint, long> _charged = new();
+
     /// <summary>Total size of everything held.</summary>
     public long ByteCount => _bytes;
 
@@ -57,6 +67,7 @@ internal sealed class ImageRegistry
 
         _byId[id] = image;
         _nodes[id] = _order.AddLast(id);
+        _charged[id] = image.ByteCount;
         _bytes += image.ByteCount;
 
         if (number != 0)
@@ -76,16 +87,29 @@ internal sealed class ImageRegistry
     /// and removing a grown image later subtracted its CURRENT size from a counter that had never
     /// been credited it, driving the total negative and disabling trimming entirely.
     /// </remarks>
-    public bool TryCharge(long delta, long budget)
+    public bool TryCharge(uint id, long delta, long budget)
     {
         if (budget > 0 && _bytes + delta > budget)
             return false;
 
         _bytes += delta;
+        if (_charged.TryGetValue(id, out var charged))
+            _charged[id] = charged + delta;
         Trim(budget);
         return true;
     }
 
+    /// <summary>Gives back bytes an image no longer holds, a deleted frame's, say.</summary>
+    public void Refund(uint id, long bytes)
+    {
+        if (bytes <= 0 || !_charged.TryGetValue(id, out var charged))
+            return;
+
+        var refund = Math.Min(bytes, charged);
+        _charged[id] = charged - refund;
+        _bytes -= refund;
+    }
+
     public bool TryGet(uint id, out TerminalImage image) => _byId.TryGetValue(id, out image!);
 
     /// <summary>Resolves a client image number to the newest image stored under it.</summary>
@@ -124,7 +148,8 @@ internal sealed class ImageRegistry
         if (!_byId.TryGetValue(id, out var existing))
             return false;
 
-        _bytes -= existing.ByteCount;
+        _bytes -= _charged.TryGetValue(id, out var charged) ? charged : existing.ByteCount;
+        _charged.Remove(id);
         _byId.Remove(id);
 
         if (_nodes.TryGetValue(id, out var node))
@@ -157,6 +182,7 @@ internal sealed class ImageRegistry
         _order.Clear();
         _nodes.Clear();
         _idByNumber.Clear();
+        _charged.Clear();
         _bytes = 0;
     }
 
