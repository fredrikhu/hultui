From cb998f7c7124c80c8f296d23a773a55c5be19767 Mon Sep 17 00:00:00 2001
From: Fredrik Hult <fredrik.hult@outlook.com>
Date: Sat, 3 Oct 2026 21:24:26 +0200
Subject: [PATCH 5/5] A row shrink drops the blank rows below the cursor

The shift that moves a shrink's difference into scrollback stops at the cursor, so with the
cursor near the top it moved nothing and the cut rows stayed below the screen for good. A
terminal created at 80x24 and sized to its pane before its first screenful is exactly that case.
Each stranded row held a slot of the ring: the scrollback kept that many lines fewer than asked
for, and every scroll reported a trim of a line nobody saw.

xterm.js pops those rows. So does this now, but only while they are blank and carry no picture; a
row with content below the cursor stays, as before.
---
 .../Buffer/ResizeEdgeCaseTests.cs             | 49 +++++++++++++++++++
 src/XTerm.NET/Buffer/TerminalBuffer.cs        | 15 ++++++
 2 files changed, 64 insertions(+)

diff --git a/src/XTerm.NET.Tests/Buffer/ResizeEdgeCaseTests.cs b/src/XTerm.NET.Tests/Buffer/ResizeEdgeCaseTests.cs
index 1729946..328c286 100644
--- a/src/XTerm.NET.Tests/Buffer/ResizeEdgeCaseTests.cs
+++ b/src/XTerm.NET.Tests/Buffer/ResizeEdgeCaseTests.cs
@@ -167,6 +167,55 @@ public class ResizeEdgeCaseTests
         Assert.Equal(terminal.Buffer.YBase, terminal.Buffer.ViewportY);
     }
 
+    /// <summary>
+    /// The same with the cursor near the top, where the shift cannot help: it stops at the cursor.
+    /// The blank rows below the cursor are dropped instead, as xterm.js drops them.
+    /// </summary>
+    /// <remarks>
+    /// A terminal created at 80x24 and sized to its pane before its first screenful is exactly this.
+    /// The rows left below the screen each held a slot of the ring, so the scrollback kept 19 lines
+    /// fewer than asked for, for the life of the terminal, and every scroll reported a trim the user
+    /// never saw.
+    /// </remarks>
+    [Fact]
+    public void ShrinkingRows_WithTheCursorNearTheTop_LeavesNothingStrandedBelowTheScreen()
+    {
+        var terminal = new Terminal(new TerminalOptions { Cols = 20, Rows = 24, Scrollback = 50 });
+        var trimmed = 0;
+        terminal.Buffer.Trimmed += n => trimmed += n;
+        terminal.Write("$ ");
+
+        terminal.Resize(20, 5);
+
+        Assert.Equal(terminal.Buffer.Lines.Length, terminal.Buffer.YBase + terminal.Rows);
+        Assert.Equal(2, terminal.Buffer.X);
+        Assert.Equal(0, terminal.Buffer.YBase + terminal.Buffer.Y);
+
+        for (var i = 0; i < 100; i++)
+            terminal.Write($"\r\nline {i}");
+
+        // The whole scrollback, and only the lines that left it counted as trimmed.
+        Assert.Equal(50, terminal.Buffer.YBase);
+        Assert.Equal(101 - 5 - 50, trimmed);
+    }
+
+    /// <summary>Only blank rows go: a row with text below the cursor stays.</summary>
+    [Fact]
+    public void ShrinkingRows_KeepsContentBelowTheCursor()
+    {
+        var terminal = new Terminal(new TerminalOptions { Cols = 20, Rows = 10, Scrollback = 50 });
+        terminal.Write("\u001b[8;1Hbelow\u001b[1;1Htop");
+
+        terminal.Resize(20, 5);
+
+        var lines = Enumerable.Range(0, terminal.Buffer.Lines.Length)
+            .Select(i => terminal.Buffer.Lines[i]!.TranslateToString(trimRight: true))
+            .ToList();
+        Assert.Equal("top", lines[0]);
+        Assert.Contains("below", lines);
+        Assert.Equal(0, terminal.Buffer.YBase + terminal.Buffer.Y);
+    }
+
     /// <summary>
     /// A zero-row resize has no viewport to overflow out of, and must not scroll the buffer.
     /// </summary>
diff --git a/src/XTerm.NET/Buffer/TerminalBuffer.cs b/src/XTerm.NET/Buffer/TerminalBuffer.cs
index d12d05e..7fce829 100644
--- a/src/XTerm.NET/Buffer/TerminalBuffer.cs
+++ b/src/XTerm.NET/Buffer/TerminalBuffer.cs
@@ -1055,6 +1055,21 @@ public class TerminalBuffer
         // resize that has no viewport at all.
         var newBottom = Math.Max(0, newRows - 1);
 
+        // Blank rows the shrink cut off below the cursor are dropped, as xterm.js does. The shift
+        // below cannot move them: it stops at the cursor, so with the cursor near the top -- a new
+        // terminal sized down before its first screenful -- they stayed below the screen for good.
+        // Each one took a slot of the ring, so the scrollback kept that many lines fewer than asked,
+        // and every scroll trimmed one line more than it showed. A row with content, or a picture,
+        // stays.
+        while (_lines.Length > _yBase + newRows
+               && _lines.Length - 1 > _yBase + _y
+               && _lines[_lines.Length - 1] is var last
+               && IsBlankLine(last)
+               && last is not { HasImages: true })
+        {
+            _lines.Pop();
+        }
+
         // The screen is the last `rows` lines of the buffer, so a shrink has to move the difference
         // into scrollback. Shifting only enough to bring the cursor on screen left lines stranded
         // BELOW the screen, where scrolling cannot reach them -- the viewport tops out at _yBase.
