# Pinned sources for the trimmed LGPL libmpv. Bump deliberately; the licence report
# and the backend tests are the check that a bump changed nothing it should not.
MPV_TAG=v0.41.0
FFMPEG_TAG=n8.1.2
LIBPLACEBO_TAG=v7.360.1
LIBASS_TAG=0.17.5
# Headers only (MIT), and the version sets the oldest NVIDIA driver CUDA decoding works
# with: 12.1 needs 530.41 on Linux, 531.61 on Windows. With an older driver, Windows falls
# back to d3d11va-copy; Linux falls back to software decoding, because the trimmed build has
# no other hardware decoder (VAAPI and VDPAU are off, and nvdec-copy needs the same CUDA).
NVCODEC_TAG=n12.1.14.0
