<Project>

  <!--
    Element origins: the DevTools inspector's "Created at" row, captured with
    [CallerFilePath]/[CallerLineNumber] on the element factories.

    Compiled in for Debug and out for Release. Two extra fields on every Element
    is not free at 10k elements, and leaving the caller attributes in place would
    bake the building machine's absolute source paths into shipped binaries.

    Override either way, independently of the configuration:
        dotnet build -c Release -p:HultUIElementOrigin=true
        dotnet build -c Debug   -p:HultUIElementOrigin=false

    This lives in .targets rather than .props because Directory.Build.props is
    imported before the SDK defaults, where $(Configuration) is still empty
    unless it was passed on the command line.

    The captured parameters stay in the signature either way — only the caller
    attributes are conditional — so an assembly built with origins on and one
    built with them off remain binary compatible.
  -->
  <PropertyGroup>
    <HultUIElementOrigin Condition="'$(HultUIElementOrigin)' == '' and '$(Configuration)' == 'Debug'">true</HultUIElementOrigin>
    <HultUIElementOrigin Condition="'$(HultUIElementOrigin)' == ''">false</HultUIElementOrigin>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HultUIElementOrigin)' == 'true'">
    <DefineConstants>$(DefineConstants);HULTUI_ELEMENT_ORIGIN</DefineConstants>
  </PropertyGroup>

  <!--
    Strict element lifetime: reading Layout or writing live-only state on an element that
    reconciliation has replaced throws instead of quietly doing nothing (Element.IsDetached).

    Every rebuild constructs a fresh tree whose values are patched into the live one and then
    discarded, so app code that captures an element during a build is holding a corpse one
    frame later. Reads go stale and writes are dropped, and neither says so - the symptom is a
    control that has simply stopped responding. This is the check that names it.

    Compiled in for Debug and out for Release: the checks sit on Layout, which every frame
    reads for every element, and a shipped build should not pay for them. Override either way,
    independently of the configuration:
        dotnet build -c Release -p:HultUIStrictLifetime=true
        dotnet build -c Debug   -p:HultUIStrictLifetime=false

    Within a strict build, Element.StrictLifetimeChecks switches it off at runtime for a test
    that means to inspect a discarded element.
  -->
  <PropertyGroup>
    <HultUIStrictLifetime Condition="'$(HultUIStrictLifetime)' == '' and '$(Configuration)' == 'Debug'">true</HultUIStrictLifetime>
    <HultUIStrictLifetime Condition="'$(HultUIStrictLifetime)' == ''">false</HultUIStrictLifetime>
  </PropertyGroup>

  <PropertyGroup Condition="'$(HultUIStrictLifetime)' == 'true'">
    <DefineConstants>$(DefineConstants);HULTUI_STRICT_LIFETIME</DefineConstants>
  </PropertyGroup>

  <!--
    Native assets for platforms HultUI does not run on, and native debug symbols, stay out
    of builds with no runtime identifier: every `dotnet build` and `dotnet test` here.

    Such a build copies every RID's natives under bin/.../runtimes/, because it could run
    anywhere. Measured 2026-10-03: 574 MB in every test and app output folder, a worktree's
    bin folders 31 GB. 315 MB of it was SkiaSharp's and HarfBuzz's native .pdb files (105 MB
    in each of win-x64, win-arm64 and win-x86), the rest platforms nothing here targets:
    Android, iOS, Mac Catalyst, musl and bionic Linux, LoongArch, RISC-V, 32-bit ARM and x86.

    What stays: win-x64, win-arm64, linux-x64, linux-arm64, the osx ones, and every generic
    RID (win, unix, linux, osx), which carry managed code. The items are removed where the
    SDK resolves package assets, before it writes the .deps.json, so the manifest and the
    folder agree. A build or publish for one RID (every app's release, NativeAOT) resolves
    only that RID's assets and is untouched.

    For a native crash in Skia, keep the symbols:   -p:HultUIKeepNativeSymbols=true
    For every platform's natives, as before:        -p:HultUIKeepAllRuntimes=true
  -->
  <Target Name="HultUITrimForeignNativeAssets" AfterTargets="ResolvePackageAssets"
          Condition="'$(RuntimeIdentifier)' == '' and '$(HultUIKeepAllRuntimes)' != 'true'">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
          Condition="$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)').StartsWith('android'))
                  or $([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)').StartsWith('ios'))
                  or $([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)').StartsWith('tvos'))
                  or $([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)').StartsWith('maccatalyst'))
                  or $([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)').StartsWith('browser'))
                  or $([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)').StartsWith('linux-musl'))
                  or $([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)').StartsWith('linux-bionic'))
                  or $([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)').StartsWith('freebsd'))
                  or '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'linux-arm'
                  or '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'linux-armel'
                  or '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'linux-x86'
                  or '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'linux-loongarch64'
                  or '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'linux-riscv64'
                  or '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'linux-s390x'
                  or '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'linux-ppc64le'
                  or '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'win-x86'
                  or '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'win-arm'" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
          Condition="'$(HultUIKeepNativeSymbols)' != 'true' and '%(RuntimeTargetsCopyLocalItems.AssetType)' == 'native' and '%(RuntimeTargetsCopyLocalItems.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
