<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe = Windows GUI subsystem: no console window is allocated when the
         app launches (on Linux/macOS this is identical to Exe). The CI runner is
         the separate Meridian.Cli console binary for exactly this reason. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(HultUITargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Meridian</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <!-- Embedded in the exe: Explorer, shortcuts and the taskbar read this.
         The runtime window icon (Linux WMs, alt-tab) is set from
         Assets\meridian.png in Program.cs. Both are generated — see
         scripts/generate-meridian-icon.py. -->
    <ApplicationIcon>Assets\meridian.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The runtime settings the five apps share (the GC's large-object threshold). -->
  <Import Project="..\..\AppRuntime.props" />

  <ItemGroup>
    <InternalsVisibleTo Include="Meridian.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Meridian.Core\Meridian.Core.csproj" />
    <ProjectReference Include="..\..\..\src\HultUI\HultUI.csproj" />
    <ProjectReference Include="..\..\..\src\HultUI.Icons\HultUI.Icons.csproj" />
    <!-- The response pane's web preview: WebView2 on Windows, the system's CEF on Linux
         (Fedora's cef package). No bundled CEF: where there is none the preview says so. -->
    <ProjectReference Include="..\..\..\src\HultUI.WebView\HultUI.WebView.csproj" />
    <ProjectReference Include="..\..\..\src\HultUI.WebView.WebView2\HultUI.WebView.WebView2.csproj" />
    <ProjectReference Include="..\..\..\src\HultUI.WebView.Cef\HultUI.WebView.Cef.csproj" />
    <ProjectReference Include="..\..\..\src\HultUI.SourceGenerators\HultUI.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
