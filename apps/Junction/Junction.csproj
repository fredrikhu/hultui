<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe = Windows GUI subsystem: no console window is allocated when the
         app launches (on Linux/macOS this is identical to Exe). -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Junction</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <!-- Embedded in the exe: Explorer, shortcuts and the Windows taskbar read
         this. The runtime window icon (Linux WMs, alt-tab) is set from
         Assets\junction.png in Program.cs. -->
    <ApplicationIcon>Assets\junction.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Junction.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HultUI\HultUI.csproj" />
    <ProjectReference Include="..\..\src\HultUI.Syntax\HultUI.Syntax.csproj" />
    <ProjectReference Include="..\..\src\HultUI.Themes\HultUI.Themes.csproj" />
    <ProjectReference Include="..\..\src\HultUI.Icons\HultUI.Icons.csproj" />
    <ProjectReference Include="..\..\src\HultUI.SourceGenerators\HultUI.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Merge request descriptions and review notes: CommonMark plus the GitLab
         extensions (task lists, strikethrough, autolinks). See Markdown.cs. -->
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

</Project>
