<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: no console window behind the picture when Explorer launches it. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Reel</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <!-- The icon Explorer and the taskbar read, embedded in the exe; the runtime window
         icon is the PNG beside it. Both are generated — scripts/generate-reel-icon.py. -->
    <ApplicationIcon>Assets/reel.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Reel.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets/*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HultUI\HultUI.csproj" />
    <ProjectReference Include="..\..\src\HultUI.Icons\HultUI.Icons.csproj" />
    <ProjectReference Include="..\..\src\HultUI.Themes\HultUI.Themes.csproj" />
    <!-- The picture, the transport overlay, and the libmpv backend behind them: Reel is
         the shell around HultUI.Media, not a second implementation of it. -->
    <ProjectReference Include="..\..\src\HultUI.Media\HultUI.Media.csproj" />
    <ProjectReference Include="..\..\src\HultUI.Media.Mpv\HultUI.Media.Mpv.csproj" />
    <ProjectReference Include="..\..\src\HultUI.SourceGenerators\HultUI.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
