<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(HultUITargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Aperture.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aperture" />
    <InternalsVisibleTo Include="Aperture.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The official Kiota-generated client. Jellyfin.Sdk 2026.10.12 is generated against
         Kiota 2.1.2. Every Kiota package is pinned to a later 2.x so that the kiota Dependabot
         group keeps them patched between SDK releases. Kiota moves to a new major only
         together with an SDK generated against it: a major removes APIs the generated code
         may call, and that fails at run time, not at build
         (docs/plans/18-major-dependency-upgrades.md). -->
    <PackageReference Include="Jellyfin.Sdk" Version="2026.10.12" />
    <PackageReference Include="Microsoft.Kiota.Abstractions" Version="2.1.6" />
    <PackageReference Include="Microsoft.Kiota.Http.HttpClientLibrary" Version="2.1.6" />
    <PackageReference Include="Microsoft.Kiota.Serialization.Form" Version="2.1.6" />
    <PackageReference Include="Microsoft.Kiota.Serialization.Json" Version="2.1.6" />
    <PackageReference Include="Microsoft.Kiota.Serialization.Multipart" Version="2.1.6" />
    <PackageReference Include="Microsoft.Kiota.Serialization.Text" Version="2.1.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- ICredentialStore only: the access token belongs in the OS credential store,
         not in the settings file. No UI types are referenced from here. -->
    <ProjectReference Include="..\..\..\src\HultUI.Core\HultUI.Core.csproj" />
  </ItemGroup>

</Project>
