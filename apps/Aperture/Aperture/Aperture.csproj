<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe = Windows GUI subsystem: no console window when the app launches
         (identical to Exe on Linux/macOS). -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Aperture</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <OptimizationPreference>Speed</OptimizationPreference>
    <!-- Embedded in the exe: Explorer, shortcuts and the taskbar read this. The runtime
         window icon (Linux WMs, alt-tab) is set from the PNG beside it in Program.cs.
         Both are generated — see scripts/generate-aperture-icon.py. -->
    <ApplicationIcon>Assets/aperture.ico</ApplicationIcon>
    <!-- Native AOT. The Kiota-generated SDK is the part that had to be proven rather
         than assumed: it compiles through ILC with no trim warnings, and the app's probe
         flag runs the whole serialization path (discovery, sign-in, an item query) as a
         native binary, which is what that flag is for. -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <!-- The runtime settings the five apps share (the GC's large-object threshold). -->
  <Import Project="..\..\AppRuntime.props" />

  <ItemGroup>
    <InternalsVisibleTo Include="Aperture.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets/*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aperture.Core\Aperture.Core.csproj" />
    <ProjectReference Include="..\..\..\src\HultUI\HultUI.csproj" />
    <ProjectReference Include="..\..\..\src\HultUI.Icons\HultUI.Icons.csproj" />
    <ProjectReference Include="..\..\..\src\HultUI.Themes\HultUI.Themes.csproj" />
    <!-- The picture and the transport overlay, and the libmpv backend behind them. -->
    <ProjectReference Include="..\..\..\src\HultUI.Media\HultUI.Media.csproj" />
    <ProjectReference Include="..\..\..\src\HultUI.Media.Mpv\HultUI.Media.Mpv.csproj" />
    <ProjectReference Include="..\..\..\src\HultUI.SourceGenerators\HultUI.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
