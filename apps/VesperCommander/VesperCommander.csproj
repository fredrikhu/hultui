<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe = Windows GUI subsystem: no console window is allocated when the
         app launches (on Linux/macOS this is identical to Exe). -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VesperCommander</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <!-- Embedded as a Win32 resource: the taskbar / Explorer / Alt-Tab icon.
         The installer reuses the same file for the setup wizard. -->
    <ApplicationIcon>Assets\vesper.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VesperCommander.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HultUI\HultUI.csproj" />
    <ProjectReference Include="..\..\src\HultUI.Syntax\HultUI.Syntax.csproj" />
    <ProjectReference Include="..\..\src\HultUI.FileIcons\HultUI.FileIcons.csproj" />
    <ProjectReference Include="..\..\src\HultUI.SourceGenerators\HultUI.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- VS Code TextMate grammars + Dark+ theme for the code preview highlighter
         (same engine the GitClient/Junction diff uses). AOT-safe: GitClient
         publishes AOT with this package. -->
  </ItemGroup>

</Project>
