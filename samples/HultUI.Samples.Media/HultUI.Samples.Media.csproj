<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The video player over a synthetic backend: a test pattern rendered on a worker
    thread at 30 fps, with a duration, tracks and a rate, so the whole transport bar is
    exercised without a decoder or a media file. Swap SyntheticMediaBackend for a real
    backend package and nothing else changes.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HultUI.Samples.Media</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HultUI\HultUI.csproj" />
    <ProjectReference Include="..\..\src\HultUI.Media\HultUI.Media.csproj" />
  </ItemGroup>

</Project>
