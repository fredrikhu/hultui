<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A terminal on an in-process demo program: colours, styles, box drawing, wide characters,
    the scrollback, a full-screen program on the alternate screen, mouse reports, titles and the
    clipboard, with no pseudoconsole (that is HultUI.Terminal.Pty, step 4 of
    docs/design/TERMINAL.md). Type help in it. The bench argument measures drawing on a real
    window: a full-screen redraw and a scrolling flood; see Program.cs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HultUI.Samples.Terminal</RootNamespace>
    <!-- Published as the apps are, which proves the package AOT-clean. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HultUI\HultUI.csproj" />
    <ProjectReference Include="..\..\src\HultUI.Terminal\HultUI.Terminal.csproj" />
    <ProjectReference Include="..\..\src\HultUI.Terminal.Pty\HultUI.Terminal.Pty.csproj" />
    <ProjectReference Include="..\..\src\HultUI.Terminal.Ssh\HultUI.Terminal.Ssh.csproj" />
  </ItemGroup>

</Project>