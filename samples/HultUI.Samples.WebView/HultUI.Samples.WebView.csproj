<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A browser window: back, forward, reload, an address bar, the page, and a status line,
    plus a home page that talks to the app through postMessage and a toolbar dropdown that
    opens over the page. WebView2 on Windows, CEF on Linux; where neither is installed, the
    fake engine's solid-colour pages (and anywhere with the fake argument). The check
    argument loads, scripts and messages the home page and exits, for proving a build
    works; see Program.cs and docs/design/WEBVIEW.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HultUI.Samples.WebView</RootNamespace>
    <!-- Published as the apps are: the WebView2 engine's hand-written COM exists for this. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HultUI\HultUI.csproj" />
    <ProjectReference Include="..\..\src\HultUI.WebView\HultUI.WebView.csproj" />
    <ProjectReference Include="..\..\src\HultUI.WebView.WebView2\HultUI.WebView.WebView2.csproj" />
    <ProjectReference Include="..\..\src\HultUI.WebView.Cef\HultUI.WebView.Cef.csproj" />
  </ItemGroup>

  <!--
    Bundled CEF, for Debian and Ubuntu, as an application takes it: the natives package from a
    feed. Off unless asked, so ordinary builds do not carry 360 MB:
      dotnet pack src/HultUI.WebView.Cef.Natives -o <feed> -p:Version=<v>
      dotnet publish samples/HultUI.Samples.WebView -r linux-x64 -p:CefNativesVersion=<v> -p:CefNativesFeed=<feed>
  -->
  <PropertyGroup Condition="'$(CefNativesVersion)' != ''">
    <RestoreAdditionalProjectSources>$(CefNativesFeed)</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup Condition="'$(CefNativesVersion)' != ''">
    <PackageReference Include="HultUI.WebView.Cef.Natives.linux-x64" Version="$(CefNativesVersion)" />
  </ItemGroup>

</Project>
