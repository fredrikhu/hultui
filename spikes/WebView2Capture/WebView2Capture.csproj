<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike W0 of docs/design/WEBVIEW.md, and deliberately not in HultUI.slnx: a
       throwaway that answers whether WebView2's composition controller can be captured
       offscreen into a HultUI frame sink, and what it costs. It uses Microsoft's managed
       WebView2 wrapper and the CsWinRT projection because they are quick to write
       against; neither is NativeAOT-clean, which is why the real package will not. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>WebView2Capture</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.*" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.*" />
    <ProjectReference Include="..\..\src\HultUI\HultUI.csproj" />
  </ItemGroup>

</Project>
