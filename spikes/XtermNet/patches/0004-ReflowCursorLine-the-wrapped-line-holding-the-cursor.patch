--- a/src/XTerm.NET/Buffer/TerminalBuffer.cs
+++ b/src/XTerm.NET/Buffer/TerminalBuffer.cs
@@ -196,6 +196,99 @@ public class TerminalBuffer
 
     private bool IsReflowEnabled => _hasScrollback && _lines.MaxLength > _rows;
 
+    /// <summary>
+    /// Reflow the wrapped line holding the cursor too, and move the cursor with its text.
+    /// </summary>
+    /// <remarks>
+    /// Off by default, which is xterm.js's rule: that line is left to the application ("the
+    /// program will handle fixing up wrapped lines with the cursor"), and a narrowing cuts it to
+    /// the new width. A shell on a Unix pty redraws its prompt on SIGWINCH, so the cut is painted
+    /// over. Behind Windows' ConPTY nothing is: ConPTY reflows its own copy of the screen, as
+    /// Windows Terminal does, and repaints nothing -- the prompt and the command being typed stay
+    /// cut, and the next echo lands where ConPTY's cursor is rather than where this one was left.
+    /// </remarks>
+    public bool ReflowCursorLine { get; set; }
+
+    /// <summary>The cursor, held as its wrapped group's first line and a cell offset into the group,
+    /// which is what survives a reflow: the line object stays the group's first row in both
+    /// directions, and the offset is the cursor's place in the group's logical text.</summary>
+    private readonly record struct CursorAnchor(BufferLine First, int Offset);
+
+    private static bool IsBlankLine(BufferLine? line) => line is null || (!line.IsWrapped && line.GetTrimmedLength() == 0);
+
+    private CursorAnchor? CaptureCursorAnchor()
+    {
+        var abs = _yBase + _y;
+        if (abs < 0 || abs >= _lines.Length)
+            return null;
+
+        var start = abs;
+        while (start > 0 && _lines[start]!.IsWrapped)
+            start--;
+        var end = abs;
+        while (end + 1 < _lines.Length && _lines[end + 1]!.IsWrapped)
+            end++;
+
+        var group = new List<BufferLine>(end - start + 1);
+        for (var i = start; i <= end; i++)
+            group.Add(_lines[i]!);
+        if (BufferReflow.IsUnreflowable(group))
+            return null;
+
+        var offset = 0;
+        for (var i = 0; i < abs - start; i++)
+            offset += BufferReflow.GetWrappedLineTrimmedLength(group, i, _cols);
+        return new CursorAnchor(group[0], offset + _x);
+    }
+
+    private void RestoreCursorAnchor(CursorAnchor anchor, int newCols, int newRows)
+    {
+        var first = -1;
+        for (var i = _lines.Length - 1; i >= 0; i--)
+        {
+            if (ReferenceEquals(_lines[i], anchor.First))
+            {
+                first = i;
+                break;
+            }
+        }
+        if (first < 0)
+            return;   // trimmed out of the scrollback with the rows above it
+
+        var group = new List<BufferLine> { _lines[first]! };
+        for (var i = first + 1; i < _lines.Length && _lines[i]!.IsWrapped; i++)
+            group.Add(_lines[i]!);
+
+        // Walk the offset down the reflowed rows. An offset that ends exactly at a row's end
+        // belongs to the start of the next row when there is one: that is where the next
+        // character goes.
+        var row = 0;
+        var remaining = anchor.Offset;
+        while (row < group.Count - 1)
+        {
+            var length = BufferReflow.GetWrappedLineTrimmedLength(group, row, newCols);
+            if (remaining < length)
+                break;
+            remaining -= length;
+            row++;
+        }
+
+        var abs = first + row;
+        var top = _yBase;
+        if (abs > top + newRows - 1)
+            top = abs - (newRows - 1);
+        top = Math.Clamp(top, 0, Math.Max(0, _lines.Length - newRows));
+        if (top != _yBase)
+        {
+            if (_yDisp == _yBase)
+                _yDisp = top;
+            _yBase = top;
+        }
+
+        _y = Math.Clamp(abs - _yBase, 0, Math.Max(0, newRows - 1));
+        _x = Math.Clamp(remaining, 0, Math.Max(0, newCols - 1));
+    }
+
     /// <summary>
     /// Gets a line from the buffer.
     /// </summary>
@@ -893,17 +986,19 @@ public class TerminalBuffer
         _y += yBaseBefore - _yBase;
         _yDisp = Math.Clamp(_yDisp, 0, _yBase);
 
+        CursorAnchor? anchor = null;
         if (_lines.Length > 0)
         {
             if (IsReflowEnabled && newCols != _cols)
             {
+                anchor = ReflowCursorLine ? CaptureCursorAnchor() : null;
                 if (newCols > _cols)
                 {
-                    ReflowLarger(newCols, newRows);
+                    ReflowLarger(newCols, newRows, skipCursorLine: anchor is null);
                 }
                 else
                 {
-                    ReflowSmaller(newCols, newRows);
+                    ReflowSmaller(newCols, newRows, skipCursorLine: anchor is null);
                 }
             }
 
@@ -1012,13 +1107,18 @@ public class TerminalBuffer
             }
             _lines.Resize(newMaxLength);
         }
+
+        // Last, after every clamp above: those keep the cursor on its old ROW, and a reflowed
+        // cursor line has moved its text to other rows.
+        if (anchor is { } a)
+            RestoreCursorAnchor(a, newCols, newRows);
     }
 
-    private void ReflowLarger(int newCols, int newRows)
+    private void ReflowLarger(int newCols, int newRows, bool skipCursorLine = true)
     {
         var nullCell = BufferCell.Space;
         var toRemove = BufferReflow.ReflowLargerGetLinesToRemove(
-            _lines, _cols, newCols, _yBase + _y, nullCell);
+            _lines, _cols, newCols, skipCursorLine ? _yBase + _y : -1, nullCell);
         if (toRemove.Length > 0)
         {
             var newLayoutResult = BufferReflow.ReflowLargerCreateNewLayout(_lines, toRemove);
@@ -1056,7 +1156,7 @@ public class TerminalBuffer
         SavedCursorState.Y = Math.Max(SavedCursorState.Y - countRemoved, 0);
     }
 
-    private void ReflowSmaller(int newCols, int newRows)
+    private void ReflowSmaller(int newCols, int newRows, bool skipCursorLine = true)
     {
         var nullCell = BufferCell.Space;
         var toInsert = new List<(int Start, List<BufferLine> NewLines)>();
@@ -1087,7 +1187,7 @@ public class TerminalBuffer
             }
 
             var absoluteY = _yBase + _y;
-            if (absoluteY >= y && absoluteY < y + wrappedLines.Count)
+            if (skipCursorLine && absoluteY >= y && absoluteY < y + wrappedLines.Count)
             {
                 continue;
             }
@@ -1188,7 +1288,11 @@ public class TerminalBuffer
             {
                 if (_yBase == 0)
                 {
-                    if (_y < newRows - 1)
+                    // Popping assumes the bottom row is blank, which holds while only groups
+                    // ABOVE the cursor are reflowed. Reflowing the cursor's own group breaks it
+                    // when that group reaches the bottom: the pop would drop its last row. Scroll
+                    // instead, then.
+                    if (_y < newRows - 1 && (skipCursorLine || IsBlankLine(_lines[_lines.Length - 1])))
                     {
                         _y++;
                         _lines.Pop();
