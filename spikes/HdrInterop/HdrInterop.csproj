<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phase 0 of docs/design/HDR.md, and deliberately not in HultUI.slnx: it is a
       throwaway that answers one question, and nothing in CI should build it or carry
       its Vulkan dependency. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>HdrInterop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- A file-based app of its own (dotnet run make-bars.cs): compiled in here, its top-level
         statements would quietly become this spike's entry point instead of Program.Main. -->
    <Compile Remove="make-bars.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Vulkan" Version="*" />
    <PackageReference Include="ppy.SDL3-CS" Version="2026.320.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.2" />
  </ItemGroup>

</Project>
