<Project>

  <!-- Repo-wide defaults. Packing is opt-in: only src/ (which re-enables it in its
       own Directory.Build.props) produces packages — apps, samples and tests never
       accidentally ride along in a `dotnet pack` of the solution. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview</VersionSuffix>
    <Authors>Fredrik Hult</Authors>
    <Company>Fredrik Hult</Company>
    <RepositoryUrl>https://github.com/fredrikhu/hultui</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- The .NET every project here builds for, in one place: each project sets
       <TargetFramework>$(HultUITargetFramework)</TargetFramework> (the Windows-only ones add
       "-windows"), so a .NET upgrade changes this line, global.json and the paths that name
       the framework (installers, workflows), not a hundred project files. A property rather
       than TargetFramework itself, so every project still says what it targets, a project with
       another target (the source generator's netstandard2.0) needs nothing, and nothing turns a
       TargetFrameworks project into a single-target one by accident. -->
  <PropertyGroup>
    <HultUITargetFramework>net11.0</HultUITargetFramework>
  </PropertyGroup>

</Project>
